# Copy this file to .env and replace the placeholders. Never commit .env.
# Values starting with "your_" are treated as "not set".

# --- Credentials -----------------------------------------------------------
# Groq LLM (answer generation + structured extraction): https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Tavily web search (live research): https://app.tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# --- Models ----------------------------------------------------------------
# Check https://console.groq.com/docs/models for currently available model IDs.
GROQ_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0
# sentence-transformers (default, downloads ~90 MB once) or hashing (offline, lower quality)
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Research agent limits (keep API cost and run time bounded) --------------
SEARCH_PROVIDER=tavily
MAX_SEARCH_QUERIES=4
MAX_RESULTS_PER_QUERY=5
MAX_PAGES=8
REQUEST_TIMEOUT=15
RESPECT_ROBOTS_TXT=true

# --- RAG ---------------------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=4
# Minimum cosine similarity for a chunk to count as evidence (-1..1).
# Default: 0.35 for sentence-transformers, 0.15 for hashing. Uncomment to override.
# RELEVANCE_THRESHOLD=0.35
CHAT_HISTORY_TURNS=3

# --- Paths and logging (relative paths are resolved from the project root) ----
# DATA_DIR=data
# INDEX_DIR=data/indexes
# REPORTS_DIR=reports
LOG_LEVEL=INFO
